# ============================================================
# .gitignore — Git 추적 제외 파일 목록
# ============================================================

# ── 환경 변수 및 비밀 키 (보안 최우선: 절대 Git에 커밋 금지) ──
.env
.env.local
.env.*.local
*.env

# ── 의존성 패키지 폴더 ──
node_modules/
package-lock.json

# ── Vercel 빌드 및 배포 캐시 ──
.vercel/

# ── 로그 파일 ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── OS 및 편집기 임시 파일 ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
