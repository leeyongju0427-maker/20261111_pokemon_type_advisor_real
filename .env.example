# ============================================================
# 포켓몬 상성 알리미 — 환경 변수 예시
# ============================================================
# 이 파일은 Git에 올라가는 "예시 파일"입니다.
# 실제 키는 절대 이 파일에 넣지 마세요!
# 이 파일을 복사해서 .env 파일을 만들고, 거기에 실제 키를 입력하세요.
# ============================================================

# ── OpenAI 설정 ──
# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=

# 사용할 OpenAI 모델명 (예: gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# ── Supabase 설정 ──
# Supabase 프로젝트 URL (예: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Supabase 익명(anon) 키 — 서버에서 사용
SUPABASE_ANON_KEY=

# (선택) Supabase 서비스 역할 키 — 서버에서만 사용, 절대 클라이언트에 노출 금지
# SUPABASE_SERVICE_ROLE_KEY=

# ── CORS 허용 도메인 ──
# 로컬 개발 시: http://localhost:3000
# 배포 시: 실제 Vercel 도메인으로 변경
ALLOWED_ORIGIN=http://localhost:3000

